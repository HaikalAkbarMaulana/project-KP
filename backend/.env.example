# Salin berkas ini menjadi .env lalu isi nilainya.
# JANGAN commit berkas .env ke git — isinya kunci rahasia.

PORT=4000

# Project Settings → API di dashboard Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role key — HANYA untuk backend, jangan pernah dipakai di frontend.
# Kunci ini melewati seluruh aturan keamanan baris (RLS) di database.
SUPABASE_SERVICE_ROLE_KEY=

# Alamat frontend yang boleh memanggil API ini.
# Boleh lebih dari satu, dipisah koma.
FRONTEND_ORIGIN=http://localhost:5173

# Isi 'production' saat dijalankan di server sekolah.
NODE_ENV=development
