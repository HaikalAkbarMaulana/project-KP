# Salin berkas ini menjadi .env lalu isi nilainya.
# Semua nilai VITE_* ikut terkirim ke browser, jadi jangan menaruh
# service_role key di sini.

# Project Settings → API di dashboard Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon public key — aman berada di frontend selama RLS aktif di database.
VITE_SUPABASE_ANON_KEY=

# Alamat backend Express
VITE_API_BASE_URL=http://localhost:4000/api
